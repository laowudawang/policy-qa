# 复制本文件为 .env.local 并填写，程序会自动读取。
# .env.local 含密钥，不要提交、不要外传。
# 不建这个文件也能跑，只是回到"只检索 + 摘原文"的模式。

# ---------- 模型接口地址 ----------
# 直接粘贴控制台给的 Base URL，原样粘，不用自己拼路径。
# 程序会自动补上 /chat/completions。
#
# 千问现在有两套入口，别混：
#   千问AI平台（platform.qianwenai.com，key 以 sk-ws- 开头）
#       https://maas.qianwenaiapi.com/compatible-mode/v1
#   阿里云百炼（bailian.console.aliyun.com）
#       团队版/工作空间  https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#       个人版/按量      https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 这几种的 key 和地址互不相通，混用报 401/404，也不抵扣额度。
# 以控制台为准：找到你要用的那个 key，抄它旁边那条 Base URL。
#
# 其他服务商：
#   DeepSeek    https://api.deepseek.com/chat/completions
#   内网网关    http://10.x.x.x:8000/v1/chat/completions
#   本地 Ollama http://127.0.0.1:11434/v1/chat/completions
LLM_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# ---------- 模型名 ----------
#   qwen3.8-flash    千问性价比款（输入 ¥0.8/百万 tokens，输出 ¥2.7）
#   qwen3.8-max      千问旗舰（输入 ¥12，输出 ¥36），额度消耗快，这里没必要
#   deepseek-chat    DeepSeek，也很快
#   内网模型         填网关里的名字，例如 qwen3.5-32b-instruct
LLM_MODEL=qwen3.8-flash

# ---------- 密钥 ----------
# 千问的 key 在阿里云百炼控制台创建：https://bailian.console.aliyun.com
# 内网模型不需要鉴权就留空
LLM_KEY=

# ---------- 厂商专有参数（可选，JSON，原样合并进请求体） ----------
# 【重要】千问 qwen3.8 / 3.7 / 3.6 / 3.5 系列是"混合思考模型"，
# enable_thinking 默认为 true —— 不关掉它会先输出一大段推理，
# 把 max_tokens 吃光，正文变成空的。用千问必须留着下面这一行：
#
LLM_EXTRA={"enable_thinking": false}
#
# 换成 DeepSeek 或内网模型时，把它注释掉——那些服务商不认这个字段，
# 会直接返回 400。
#
# 反过来想让 qwen3.8-max 少想一点省点钱，可以配：
#   LLM_EXTRA={"enable_thinking": true, "reasoning_effort": "low"}
# 反过来想让 qwen3.8-max 少想一点省点钱，可以配：
#   LLM_EXTRA={"enable_thinking": true, "reasoning_effort": "low"}
#
# 其他服务商不认的字段可能报 400，用不上就整行删掉。

# ---------- 答案长度上限（可选，默认 900） ----------
# 答案按 500 字设计，900 够用。真要开思考模式，这里得配到 2000 以上，
# 否则正文仍然会被推理内容挤掉。
# LLM_MAX_TOKENS=900
